<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=0686efefc2819424db2a07dd694bc8b4&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="Background" class="background"/>
    <ui:VisualElement name="MainMenuContainer" class="main-menu-container">
        <ui:VisualElement name="GameLogo" class="game-logo"/>
        <ui:VisualElement name="ButtonsContainer" class="buttons-container">
            <ui:Button text="" name="StartGameButton" class="menu-button start-game-button">
                <ui:Label text="START GAME" class="button-label start-game-label"/>
            </ui:Button>
            <ui:Button text="" name="OptionsButton" class="menu-button options-button options-button--offset">
                <ui:Label text="OPTIONS" class="button-label options-label"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="OptionsMenu" class="options-menu hidden">
        <ui:VisualElement name="OptionsBackground" class="options-background"/>
        <ui:VisualElement name="OptionsContent" class="options-content">
            <ui:VisualElement name="TitleContainer" class="title-container title-container--positioned">
                <ui:Label text="OPTIONS" name="TitleText" class="title-text title-text--large"/>
            </ui:VisualElement>
            <ui:VisualElement name="MainContainer" class="main-container">
                <ui:VisualElement name="OptionsButtonsContainer" class="options-buttons-container options-buttons-container--sized">
                    <ui:Button text="" name="AudioTabButton" class="tab-button audio-tab-button active tab-button--sized">
                        <ui:Label text="AUDIO" class="tab-label roboto-font"/>
                    </ui:Button>
                    <ui:Button text="" name="StatisticsTabButton" class="tab-button statistics-tab-button tab-button--sized tab-button--margin-bottom">
                        <ui:Label text="STATISTIC" class="tab-label roboto-font"/>
                    </ui:Button>
                    <ui:Button text="" name="InfoTabButton" class="info-tab-button tab-button tab-button--sized">
                        <ui:Label text="INFORMATION" class="tab-label roboto-font"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="SettingsContainer" class="settings-container settings-container--sized">
                    <ui:VisualElement name="AudioSettings" class="settings-panel audio-settings audio-settings--padded">
                        <ui:VisualElement name="MasterVolumeRow" class="audio-row audio-row--master">
                            <ui:VisualElement name="MasterVolumeIconContainer" class="icon-container">
                                <ui:VisualElement name="MasterIcon" class="master-icon"/>
                            </ui:VisualElement>
                            <ui:Button text="" name="MasterVolumeDown" class="volume-button down-volume-button volume-button--transparent"/>
                            <ui:Slider label="" value="100" high-value="100" name="MasterVolumeSlider" class="volume-slider volume-slider--bottom-margin"/>
                            <ui:Button text="" name="MasterVolumeUp" class="volume-button volume-button--transparent"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="MusicVolumeRow" class="audio-row audio-row--music">
                            <ui:VisualElement name="MusicVolumeIconContainer" class="icon-container">
                                <ui:VisualElement name="MusicIcon" class="music-icon"/>
                            </ui:VisualElement>
                            <ui:Button text="" name="MusicVolumeDown" class="volume-button down-volume-button volume-button--transparent"/>
                            <ui:Slider label="" value="100" high-value="100" name="MusicVolumeSlider" class="volume-slider volume-slider--bottom-margin"/>
                            <ui:Button text="" name="MusicVolumeUp" class="volume-button volume-button--transparent"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="StatisticsSettings" class="settings-panel statistics-settings hidden statistics-settings--padded">
                        <ui:VisualElement name="TimeStatRow" class="stats-row stats-row--time">
                            <ui:VisualElement name="TimeIconContainer" class="stats-icon-column">
                                <ui:VisualElement name="TimerIcon" class="stat-icon timer-icon"/>
                            </ui:VisualElement>
                            <ui:Label text="00:00:00" name="TimeStatText" class="stat-text stat-text--time rubik-font stat-text--normal-style"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="DeathsStatRow" class="stats-row stats-row--deaths">
                            <ui:VisualElement name="DeathsIconContainer" class="stats-icon-column">
                                <ui:VisualElement name="SkullIcon" class="stat-icon skull-icon"/>
                            </ui:VisualElement>
                            <ui:Label text="2" name="DeathsStatText" class="stat-text stat-text--deaths rubik-font stat-text--normal-style"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="FlasksStatRow" class="stats-row stats-row--flasks">
                            <ui:VisualElement name="FlaskIconContainer" class="stats-icon-column">
                                <ui:VisualElement name="FlaskIcon" class="stat-icon flask-icon"/>
                            </ui:VisualElement>
                            <ui:Label text="1/2" name="FlasksStatText" class="stat-text stat-text--flasks rubik-font stat-text--normal-style"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="InfoSettings" class="settings-panel info-settings hidden info-settings--padded">
                        <ui:VisualElement name="Row1" class="info-row info-row--margin-bottom">
                            <ui:VisualElement name="MaxContainer" class="member-container member-container--no-padding">
                                <ui:Label text="Плотников Максим" name="MaxName" class="member-name member-name--info rubik-font"/>
                                <ui:Label text="Unity - разработчик" name="MaxRole" class="member-role member-role--info rubik-font"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="ReginaContainer" class="member-container member-container--no-padding">
                                <ui:Label text="Гиззатуллина Регина" name="ReginaName" class="member-name member-name--info member-name--fixed-height rubik-font"/>
                                <ui:Label text="Tech - дизайнер" name="ReginaRole" class="member-role member-role--info"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="Row2" class="info-row info-row--margin-bottom">
                            <ui:VisualElement name="DenisContainer" class="member-container member-container--no-padding">
                                <ui:Label text="Нацибулин Денис" name="DenisName" class="member-name member-name--info rubik-font"/>
                                <ui:Label text="Unity - разработчик" name="DenisRole" class="member-role member-role--info rubik-font"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="AlinaContainer" class="member-container member-container--no-padding">
                                <ui:Label text="Яруллина Алина" name="AlinaName" class="member-name member-name--info rubik-font"/>
                                <ui:Label text="Props - художник" name="AlinaRole" class="member-role member-role--info"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="Row3" class="info-row">
                            <ui:VisualElement name="AlexContainer" class="member-container member-container--no-padding">
                                <ui:Label text="Наврузов Алексей" name="AlexName" class="member-name member-name--info rubik-font"/>
                                <ui:Label text="Гейм - дизайнер" name="AlexRole" class="member-role member-role--info rubik-font"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="IrinaContainer" class="member-container member-container--no-padding">
                                <ui:Label text="Демидова Ирина" name="IrinaName" class="member-name member-name--info rubik-font"/>
                                <ui:Label text="BG - художник" name="IrinaRole" class="member-role member-role--info rubik-font"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="" name="CloseOptionsButton" class="close-options-button close-options-button--positioned"/>
    </ui:VisualElement>
</ui:UXML>
