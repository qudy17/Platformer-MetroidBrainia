:root {
    --background-image: url("project://database/Assets/UI/MainMenu/MenuBackground.png?fileID=-961990212438608285&guid=7ffbbe36ff6c7994f9c10b8818dff148&type=3#MenuBackground_0");
    --game-logo-image: url("project://database/Assets/UI/MainMenu/Yell.png?fileID=-276854878510880552&guid=36a2be57b0361dd419122cd98bf2db14&type=3#Yell_0");
    --buttons-container-bg: url("project://database/Assets/UI/MainMenu/ButtonsContainerBGMainMenu.svg?fileID=7388822144124034973&guid=559841901192d7445957b5a5791de8c7&type=3#ButtonsContainerBGMainMenu");
    --start-button-default: url("project://database/Assets/UI/Pnga/button_start_normal.png");
    --start-button-hover: url("project://database/Assets/UI/MainMenu/StartButtonHover.png?fileID=-1410543623192155935&guid=cc6e7a3a12f65404ab66e0ba8aeabcca&type=3#StartButtonHover_0");
    --options-button-default: url("project://database/Assets/UI/aPng/button_options_normal.png");
    --options-button-hover: url("project://database/Assets/UI/MainMenu/OptionsButtonHover.png?fileID=6998123776648737841&guid=4c32265e16351e94b98cd06694df2947&type=3#OptionsButtonHover_0");
    --options-background: url("project://database/Assets/UI/Options/OptionsBackground.png?fileID=836023105048073361&guid=c36c6881fabc90245b5b59d2eb9a27ea&type=3#OptionsBackground_0");
    --title-container-bg: url("project://database/Assets/UI/Options/OptionsTitleContainer.png?fileID=-3871136307603959565&guid=884ceaee47afb9e4aa5ca74082b10b2f&type=3#OptionsTitleContainer_0");
    --options-buttons-container-bg: url("project://database/Assets/UI/Options/OptionsButtonsContainer.svg?fileID=7388822144124034973&guid=dd88018219ad44645835a5e2be2b888c&type=3#OptionsButtonsContainer");
    --settings-container-bg: url("project://database/Assets/UI/Options/SettingsContainer.svg?fileID=7388822144124034973&guid=1870d2355e3edfa4fb842069aaab3618&type=3#SettingsContainer");
    --audio-button-default: url("project://database/Assets/UI/Sprites/AudioButton_Default.png");
    --audio-button-hover: url("project://database/Assets/UI/Options/AudioButtonHover.png");
    --audio-button-active: url("project://database/Assets/UI/Options/AudioButtonActive.png");
    --statistics-button-default: url("project://database/Assets/UI/Sprites/StatisticsButton_Default.png");
    --statistics-button-hover: url("project://database/Assets/UI/Options/StatisticButtonHover.png");
    --statistics-button-active: url("project://database/Assets/UI/Options/StatisticButtonActive.png");
    --info-button-default: url("project://database/Assets/UI/Sprites/InfoButton_Default.png");
    --info-button-hover: url("project://database/Assets/UI/Options/InformationButtonHover.png");
    --info-button-active: url("project://database/Assets/UI/Options/InformationButtonActive.png");
    --timer-icon: url("project://database/Assets/UI/Options/TimeIcon.svg");
    --skull-icon: url("project://database/Assets/UI/Options/SkullICon.svg");
    --flask-icon: url("project://database/Assets/UI/Options/FlaskIcon.svg");
    --close-button: url("project://database/Assets/UI/Options/CloseButton.png?fileID=7228427573584015795&guid=12f307e7bba14934184817ca02f172c8&type=3#CloseButton_0");
    --dragger: url("project://database/Assets/UI/Options/SliderDragger.svg");
    --volume-icon-container: url("project://database/Assets/UI/Options/VolumeIconContainer.png");
    --master-volume-icon: url("project://database/Assets/UI/Options/MasterVolumeIcon.svg");
    --music-volume-icon: url("project://database/Assets/UI/Options/MusicVolumeIcon.svg");
    --volume-button: url("project://database/Assets/UI/Options/VolumeButton.svg");
    --rubik-font: url("project://database/Assets/UI/MainMenu/Rubik-Regular.ttf?fileID=12800000&guid=0d91f7049f2966244ab5e9b102f76dbd&type=3#Rubik-Regular");
    --roboto-font: url("project://database/Assets/PluginYourGames/Example/Content/Font/Roboto-Regular.ttf?fileID=12800000&guid=4b10251d8d1a40c4d97edcf51fc6b4ea&type=3#Roboto-Regular");
    --text-color: rgb(255, 255, 255);
    --text-shadow: rgba(0, 0, 0, 0.8);
    --accent-color: rgb(242, 61, 112);
}

.rubik-font {
    -unity-font-definition: var(--rubik-font);
}

.roboto-font {
    -unity-font-definition: var(--roboto-font);
}

.background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: var(--background-image);
    -unity-background-scale-mode: scale-and-crop;
}

.main-menu-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: 64px;
    padding-top: 64px;
}

.game-logo {
    width: 719px;
    height: 281px;
    background-image: var(--game-logo-image);
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 64px;
    margin-top: 32px;
    margin-left: 64px;
}

.buttons-container {
    width: 832px;
    height: 384px;
    flex-direction: column;
    align-items: flex-start;
    background-image: var(--buttons-container-bg);
    -unity-background-scale-mode: scale-to-fit;
    padding: 20px;
    margin-top: 32px;
    -unity-background-image-tint-color: rgb(18, 21, 28);
}

.menu-button {
    width: 376px;
    height: 144px;
    margin-bottom: 20px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.2s;
    cursor: link;
    /* Reset default Button padding and margin */
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-left: 20px;
    margin-top: 20px;
    display: flex;
}

.options-button--offset {
    margin-top: 2px;
}

.button-label {
    display: flex;
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/MainMenu/Rubik-VariableFont_wght.ttf?fileID=12800000&guid=2cc1220340d431846af58f2e7da8da3a&type=3#Rubik-VariableFont_wght");
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.start-game-label {
    margin-top: 35px;
    margin-left: 30px;
}

.options-label {
    margin-top: 30px;
    margin-left: 30px;
}

.start-game-button {
    background-image: var(--start-button-default);
}

.start-game-button:hover {
    background-image: var(--start-button-hover);
    scale: 1.05;
}

.start-game-button:active {
    scale: 0.98;
}

.options-button {
    background-image: var(--options-button-default);
}

.options-button:hover {
    background-image: var(--options-button-hover);
    scale: 1.05;
}

.options-button:active {
    scale: 0.98;
}

.options-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    opacity: 1;
}

.options-menu.hidden {
    display: none;
}

.options-background {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-image: var(--options-background);
    -unity-background-scale-mode: scale-and-crop;
}

.options-content {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    flex-direction: column;
    padding: 30px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    display: flex;
}

.title-container {
    width: 400px;
    height: 100px;
    background-image: var(--title-container-bg);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.title-container--positioned {
    width: 594px;
    height: 218px;
    background-position-x: center;
    right: 648px;
    left: 34%;
    margin-bottom: 0;
    padding-bottom: 0;
    top: -9px;
}

.title-text {
    font-size: 48px;
    color: var(--text-color);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 4px var(--text-shadow);
    -unity-font-definition: var(--rubik-font);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.title-text--large {
    font-size: 64px;
}

.main-container {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
}

.options-buttons-container {
    width: 35%;
    min-width: 300px;
    background-image: var(--options-buttons-container-bg);
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: column;
    padding: 20px;
    margin-right: 20px;
    -unity-background-image-tint-color: rgb(18, 21, 28);
}

.options-buttons-container--sized {
    width: 552px;
    height: 673px;
    margin-right: 0;
    margin-left: 34px;
    margin-top: 15px;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
}

.tab-button {
    width: 100%;
    height: 80px;
    margin-bottom: 15px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.2s;
    cursor: link;
    /* Reset default Button padding */
    padding-top: 0;
    padding-bottom: 0;
}

.tab-button--sized {
    height: 144px;
    width: 376px;
    justify-content: flex-start;
    align-items: stretch;
    margin-top: 0;
}

.tab-button--margin-bottom {
    margin-bottom: 40px;
}

.audio-tab-button.tab-button--sized {
    margin-bottom: 50px;
}

.tab-button:active {
    scale: 0.98;
}

.tab-label {
    color: rgb(255, 255, 255);
    justify-content: center;
    align-items: center;
    align-self: auto;
    align-content: auto;
    margin-top: 30px;
    font-size: 48px;
}

.audio-tab-button {
    background-image: var(--audio-button-default);
}

.audio-tab-button:hover {
    background-image: var(--audio-button-hover);
    scale: 1.05;
}

.audio-tab-button.active {
    background-image: var(--audio-button-active);
}

.statistics-tab-button {
    background-image: var(--statistics-button-default);
}

.statistics-tab-button:hover {
    background-image: var(--statistics-button-hover);
    scale: 1.05;
}

.statistics-tab-button.active {
    background-image: var(--statistics-button-active);
}

.info-tab-button {
    background-image: var(--info-button-default);
}

.info-tab-button:hover {
    background-image: var(--info-button-hover);
    scale: 1.05;
}

.info-tab-button.active {
    background-image: var(--info-button-active);
}

.settings-container {
    width: 60%;
    flex-grow: 1;
    background-image: var(--settings-container-bg);
    -unity-background-scale-mode: stretch-to-fill;
    padding: 30px;
    -unity-background-image-tint-color: rgb(18, 21, 28);
}

.settings-container--sized {
    width: 1112px;
    height: 619px;
    margin-left: 65px;
    margin-top: 49px;
    margin-right: 100px;
    padding-bottom: 0;
}

.settings-panel {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.settings-panel.hidden {
    display: none;
}

.audio-settings {
    flex-direction: column;
}

.audio-settings--padded {
    padding-top: 20px;
}

.audio-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
    margin-top: 50px;
    width: 100%;
}

.audio-row--master {
    margin-left: 60px;
    padding-right: 120px;
    margin-bottom: 105px;
}

/* Music row */
.audio-row--music {
    margin-left: 60px;
    margin-right: 0;
    padding-right: 120px;
}

.icon-container {
    width: 128px;
    height: 128px;
    background-image: var(--volume-icon-container);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
    flex-shrink: 0;
}

.master-icon,
.music-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
}

.master-icon {
    background-image: var(--master-volume-icon);
}

.music-icon {
    background-image: var(--music-volume-icon);
}

.volume-button {
    width: 50px;
    height: 50px;
    margin-left: 10px;
    margin-right: 10px;
    background-image: var(--volume-button);
}

.volume-button--transparent {
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.volume-button.down-volume-button {
    scale: -1 1;
}

.volume-button:hover {
    scale: 1.1;
}

.volume-button.down-volume-button:hover {
    scale: -1.1 1.1;
}

.volume-button:active {
    scale: 0.95;
}

.volume-button.down-volume-button:active {
    scale: -0.95 0.95;
}

.volume-slider {
    flex-grow: 1;
    min-width: 200px;
}

.volume-slider--bottom-margin {
    margin-bottom: 60px;
}

.volume-slider .unity-base-slider__fill {
    background-color: #F23D70;
    height: 64px;
    border-radius: 40px;
}

.volume-slider .unity-base-slider__tracker {
    background-color: white;
    border-radius: 40px;
    height: 64px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
}

.volume-slider .unity-base-slider__dragger {
    width: 56px;
    height: 48px;
    border-radius: 50%;
    border-width: 0px;
    border-color: rgb(255, 255, 255);
    -unity-background-image-tint-color: #F23D70;
    top: -30px;
    background-image: var(--dragger);
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.volume-slider .unity-base-slider__dragger:hover {
    scale: 1.2;
}

.volume-slider .unity-base-slider__dragger:active {
    background-color: rgb(150, 150, 255);
}

.statistics-settings {
    flex-direction: column;
    padding: 50px 60px;
}

.statistics-settings--padded {
    padding-top: 50px;
}

.stats-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 50px;
    width: 100%;
}

.stats-row--time {
    margin-left: 175px;
    margin-bottom: 100px;
}

.stats-row--deaths {
    margin-left: 175px;
    margin-bottom: 100px;
}

.stats-row--flasks {
    margin-left: 175px;
    margin-bottom: 0;
}

.stats-icon-column {
    width: 128px;
    height: 128px;
    background-image: var(--volume-icon-container);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.stats-text-column {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.stat-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

.timer-icon {
    background-image: var(--timer-icon);
}

.skull-icon {
    background-image: var(--skull-icon);
}

.flask-icon {
    background-image: var(--flask-icon);
}

.stat-text {
    font-size: 48px;
    color: var(--text-color);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px var(--text-shadow);
    text-align: right;
    flex-grow: 1;
    margin-left: 40px;
}

.stat-text--normal-style {
    -unity-font-style: normal;
}

.stat-text--time {
    padding-left: 200px;
}

.stat-text--deaths {
    padding-left: 300px;
}

.stat-text--flasks {
    padding-left: 285px;
}

.info-settings {
    flex-direction: column;
    padding: 30px 40px;
    gap: 30px;
}

.info-settings--padded {
    padding-top: 50px;
}

.info-row {
    flex-direction: row;
    justify-content: space-between;
    width: 95%;
}

.info-row--margin-bottom {
    margin-bottom: 50px;
    width: 95%;
}


.member-container {
    flex-direction: column;
    width: 45%;
    padding: 15px 20px;
}

.member-container--no-padding {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.member-name {
    font-size: 24px;
    color: var(--text-color);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px var(--text-shadow);
    margin-bottom: 8px;
}

.member-name--info {
    font-size: 48px;
    -unity-font-style: normal;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.member-name--fixed-height {
    height: 55px;
}

.member-role {
    font-size: 18px;
    color: rgb(200, 200, 200);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.member-role--info {
    font-size: 40px;
    color: var(--accent-color);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.close-options-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 60px;
    height: 60px;
    font-size: 32px;
    -unity-font-style: bold;
    background-color: rgb(150, 50, 50);
    color: white;
    border-width: 3px;
    border-color: white;
    border-radius: 10px;
    -unity-text-align: middle-center;
    cursor: link;
    background-image: var(--close-button);
}

.close-options-button--positioned {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-right: 16px;
    margin-top: 16px;
}

.close-options-button:hover {
    background-color: rgb(200, 80, 80);
    scale: 1.1;
}

.close-options-button:active {
    background-color: rgb(120, 40, 40);
    scale: 0.95;
}
