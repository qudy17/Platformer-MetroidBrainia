<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/OptionsMenu.uss?fileID=7433441132597879392&amp;guid=a2f45cafd67d3da488ecdfc91b719516&amp;type=3#OptionsMenu"/>
    <ui:VisualElement name="OptionsRoot" class="options-root" style="flex-grow: 1;">
        <ui:VisualElement name="OptionsBackground" class="options-background" style="flex-grow: 1;"/>
        <ui:VisualElement name="OptionsContent" class="options-content" style="flex-grow: 1;">
            <ui:VisualElement name="TitleContainer" class="title-container" style="flex-grow: 1;">
                <ui:Label text="Options" name="TitleText" class="title-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="MainContainer" class="main-container" style="flex-grow: 1;">
                <ui:VisualElement name="OptionsButtonsContainer" class="options-buttons-container" style="flex-grow: 1;">
                    <ui:Button text="Button" name="AudioTabButton" class="tab-button audio-tab-button active"/>
                    <ui:Button text="Button" name="StatisticsTabButton" class="tab-button statistics-tab-button"/>
                    <ui:Button text="Button" name="InfoTabButton" class="info-tab-button tab-button"/>
                </ui:VisualElement>
                <ui:VisualElement name="SettingsContainer" class="settings-container" style="flex-grow: 1;">
                    <ui:VisualElement name="AudioSettings" class="settings-panel audio-settings" style="flex-grow: 1;">
                        <ui:VisualElement name="MasterVolumeRow" class="audio-row" style="flex-grow: 1;">
                            <ui:Label text="Master Volume" name="MasterVolumeLabel" class="audio-label"/>
                            <ui:Button text="-" name="MasterVolumeDown" class="volume-button"/>
                            <ui:Slider label="" value="100" high-value="100" name="MasterVolumeSlider" class="volume-slider"/>
                            <ui:Button text="+" name="MasterVolumeUp" class="volume-button"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="MusicVolumeRow" class="audio-row" style="flex-grow: 1;">
                            <ui:Label text="Music Volume" name="MusicVolumeLabel" class="audio-label"/>
                            <ui:Button text="-" name="MusicVolumeDown" class="volume-button"/>
                            <ui:Slider label="" value="100" high-value="100" name="MusicVolumeSlider" class="volume-slider"/>
                            <ui:Button text="+" name="MusicVolumeUp" class="volume-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="StatisticsSettings" class="settings-panel statistics-settings hidden" style="flex-grow: 1;">
                        <ui:VisualElement name="TimeStatRow" class="stats-row" style="flex-grow: 1;">
                            <ui:VisualElement name="TimerIcon" class="timer-icon stat-icon" style="flex-grow: 1;"/>
                            <ui:Label text="Time: 00:00" name="TimeStatText" class="stat-text"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="DeathsStatRow" class="stats-row" style="flex-grow: 1;">
                            <ui:VisualElement name="SkullIcon" class="stat-icon skull-icon" style="flex-grow: 1;"/>
                            <ui:Label text="Deaths: 0" name="DeathsStatTex" class="stat-text"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="FlasksStatRow" class="stats-row" style="flex-grow: 1;">
                            <ui:VisualElement name="FlaskIcon" class="stat-icon flask-icon" style="flex-grow: 1;"/>
                            <ui:Label text="Flasks: 0/0" name="FlasksStatText" class="stat-text"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="InfoSettings" class="settings-panel info-settings hidden" style="flex-grow: 1;">
                        <ui:VisualElement name="RolesColumn" class="info-column" style="flex-grow: 1;">
                            <ui:Label text="Unity - разработчик" class="info-item"/>
                            <ui:Label text="Tech - дизайнер" class="info-item"/>
                            <ui:Label text="Unity - разработчик" class="info-item"/>
                            <ui:Label text="Props - художник" class="info-item"/>
                            <ui:Label text="BG - художник" class="info-item"/>
                            <ui:Label text="Гейм - дизайнер" class="info-item"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="NamesColumn" class="info-column" style="flex-grow: 1;">
                            <ui:Label text="Яруллина Алина" class="info-item"/>
                            <ui:Label text="Плотников Максим" class="info-item"/>
                            <ui:Label text="Нацибулин Денис" class="info-item"/>
                            <ui:Label text="Гиззатуллина Регина " class="info-item"/>
                            <ui:Label text="Демидова Ирина" class="info-item"/>
                            <ui:Label text="Наврузов Алексей" class="info-item"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Button" name="CloseButton" class="close-button"/>
    </ui:VisualElement>
</ui:UXML>
