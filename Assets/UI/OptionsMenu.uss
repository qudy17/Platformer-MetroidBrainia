/* ==================== ÏÅĞÅÌÅÍÍÛÅ (ÏÓÒÈ Ê ĞÅÑÓĞÑÀÌ) ==================== */
:root {
    /* ÇÀÌÅÍÈÒÅ ÍÀ ÑÂÎÈ ÏÓÒÈ */
    --options-background: url('project://database/Assets/UI/Sprites/OptionsBackground.png');
    --title-container-bg: url('project://database/Assets/UI/Sprites/TitleContainerBG.png');
    --buttons-container-bg: url('project://database/Assets/UI/Sprites/OptionsButtonsContainerBG.png');
    --settings-container-bg: url('project://database/Assets/UI/Sprites/SettingsContainerBG.png');
    
    /* Êíîïêè ïåğåêëş÷åíèÿ */
    --audio-button-default: url('project://database/Assets/UI/Sprites/AudioButton_Default.png');
    --audio-button-hover: url('project://database/Assets/UI/Sprites/AudioButton_Hover.png');
    --audio-button-active: url('project://database/Assets/UI/Sprites/AudioButton_Active.png');
    
    --statistics-button-default: url('project://database/Assets/UI/Sprites/StatisticsButton_Default.png');
    --statistics-button-hover: url('project://database/Assets/UI/Sprites/StatisticsButton_Hover.png');
    --statistics-button-active: url('project://database/Assets/UI/Sprites/StatisticsButton_Active.png');
    
    --info-button-default: url('project://database/Assets/UI/Sprites/InfoButton_Default.png');
    --info-button-hover: url('project://database/Assets/UI/Sprites/InfoButton_Hover.png');
    --info-button-active: url('project://database/Assets/UI/Sprites/InfoButton_Active.png');
    
    /* Èêîíêè ñòàòèñòèêè */
    --timer-icon: url('project://database/Assets/UI/Sprites/TimerIcon.png');
    --skull-icon: url('project://database/Assets/UI/Sprites/SkullIcon.png');
    --flask-icon: url('project://database/Assets/UI/Sprites/FlaskIcon.png');
    
    /* Öâåòà */
    --text-color: rgb(255, 255, 255);
    --text-shadow: rgba(0, 0, 0, 0.8);
}

/* ==================== ÎÑÍÎÂÍÎÉ ÊÎÍÒÅÉÍÅĞ ==================== */

.options-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

/* Ôîí */
.options-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: var(--options-background);
    -unity-background-scale-mode: scale-and-crop;
}

/* Êîíòåíò ïîâåğõ ôîíà */
.options-content {
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 30px;
}

/* ==================== ÇÀÃÎËÎÂÎÊ ==================== */

.title-container {
    width: 400px;
    height: 100px;
    background-image: var(--title-container-bg);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.title-text {
    font-size: 48px;
    color: var(--text-color);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 4px var(--text-shadow);
}

/* ==================== ÃËÀÂÍÛÉ ÊÎÍÒÅÉÍÅĞ (ÊÍÎÏÊÈ + ÍÀÑÒĞÎÉÊÈ) ==================== */

.main-container {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
}

/* ==================== ÊÎÍÒÅÉÍÅĞ ÊÍÎÏÎÊ (ÑËÅÂÀ) ==================== */

.options-buttons-container {
    width: 35%;
    min-width: 300px;
    background-image: var(--buttons-container-bg);
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: column;
    padding: 20px;
    margin-right: 20px;
}

/* Êíîïêè ïåğåêëş÷åíèÿ */
.tab-button {
    width: 100%;
    height: 80px;
    margin-bottom: 15px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.2s;
}

/* Audio Button */
.audio-tab-button {
    background-image: var(--audio-button-default);
}

.audio-tab-button:hover {
    background-image: var(--audio-button-hover);
    scale: 1.05;
}

.audio-tab-button.active {
    background-image: var(--audio-button-active);
}

/* Statistics Button */
.statistics-tab-button {
    background-image: var(--statistics-button-default);
}

.statistics-tab-button:hover {
    background-image: var(--statistics-button-hover);
    scale: 1.05;
}

.statistics-tab-button.active {
    background-image: var(--statistics-button-active);
}

/* Info Button */
.info-tab-button {
    background-image: var(--info-button-default);
}

.info-tab-button:hover {
    background-image: var(--info-button-hover);
    scale: 1.05;
}

.info-tab-button.active {
    background-image: var(--info-button-active);
}

/* ==================== ÊÎÍÒÅÉÍÅĞ ÍÀÑÒĞÎÅÊ (ÑÏĞÀÂÀ) ==================== */

.settings-container {
    width: 60%;
    flex-grow: 1;
    background-image: var(--settings-container-bg);
    -unity-background-scale-mode: stretch-to-fill;
    padding: 30px;
}

/* Ñêğûòèå íåàêòèâíûõ ïàíåëåé */
.settings-panel {
    width: 100%;
    height: 100%;
}

.settings-panel.hidden {
    display: none;
}

/* ==================== ÀÓÄÈÎ ÍÀÑÒĞÎÉÊÈ ==================== */

.audio-settings {
    flex-direction: column;
}

.audio-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
    width: 100%;
}

.audio-label {
    font-size: 24px;
    color: var(--text-color);
    width: 200px;
    -unity-text-align: middle-left;
    margin-right: 20px;
}

.volume-button {
    width: 50px;
    height: 50px;
    font-size: 28px;
    background-color: rgb(80, 80, 80);
    color: white;
    border-width: 2px;
    border-color: white;
    border-radius: 8px;
    margin-left: 10px;
    margin-right: 10px;
}

.volume-button:hover {
    background-color: rgb(120, 120, 120);
    scale: 1.1;
}

.volume-button:active {
    background-color: rgb(60, 60, 60);
}

.volume-slider {
    flex-grow: 1;
    min-width: 200px;
}

/* Ñòèëèçàöèÿ ñëàéäåğà */
.volume-slider .unity-base-slider__tracker {
    background-color: rgb(60, 60, 60);
    border-radius: 10px;
    height: 10px;
}

.volume-slider .unity-base-slider__dragger {
    width: 20px;
    height: 20px;
    background-color: white;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
}

.volume-slider .unity-base-slider__dragger:hover {
    background-color: rgb(200, 200, 255);
    scale: 1.2;
}

/* ==================== ÑÒÀÒÈÑÒÈÊÀ ==================== */

.statistics-settings {
    flex-direction: column;
}

.stats-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 25px;
}

.stat-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 20px;
}

.timer-icon {
    background-image: var(--timer-icon);
}

.skull-icon {
    background-image: var(--skull-icon);
}

.flask-icon {
    background-image: var(--flask-icon);
}

.stat-text {
    font-size: 32px;
    color: var(--text-color);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px var(--text-shadow);
}

/* ==================== ÈÍÔÎĞÌÀÖÈß Î ÊÎÌÀÍÄÅ ==================== */

.info-settings {
    flex-direction: row;
}

.info-column {
    flex-direction: column;
    width: 50%;
    padding-right: 20px;
}

.info-header {
    font-size: 28px;
    color: var(--text-color);
    -unity-font-style: bold;
    margin-bottom: 15px;
    text-shadow: 2px 2px 4px var(--text-shadow);
}

.info-item {
    font-size: 20px;
    color: var(--text-color);
    margin-bottom: 10px;
}

/* ==================== ÊÍÎÏÊÀ ÇÀÊĞÛÒÈß ==================== */

.close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 60px;
    height: 60px;
    font-size: 32px;
    background-color: rgb(150, 50, 50);
    color: white;
    border-width: 3px;
    border-color: white;
    border-radius: 10px;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgb(200, 80, 80);
    scale: 1.1;
}

.close-button:active {
    background-color: rgb(120, 40, 40);
}