/* ==================== ПЕРЕМЕННЫЕ ==================== */
:root {
    /* Используем те же переменные что и в главном меню */
    --pause-background: url('project://database/Assets/UI/Sprites/PauseBackground.png');
    --title-container-bg: url('project://database/Assets/UI/Sprites/TitleContainerBG.png');
    --options-buttons-container-bg: url('project://database/Assets/UI/Sprites/OptionsButtonsContainerBG.png');
    --settings-container-bg: url('project://database/Assets/UI/Sprites/SettingsContainerBG.png');
    
    /* Кнопка Resume */
    --resume-button-default: url('project://database/Assets/UI/Png/button_start_normal.png');
    --resume-button-hover: url('project://database/Assets/UI/Sprites/ResumeButton_Hover.png');
    --resume-button-active: url('project://database/Assets/UI/Sprites/ResumeButton_Active.png');
    
    /* Кнопки вкладок (переиспользуем из главного меню) */
    --audio-button-default: url('project://database/Assets/UI/Png/button_start_normal.png');
    --audio-button-hover: url('project://database/Assets/UI/Sprites/AudioButton_Hover.png');
    --audio-button-active: url('project://database/Assets/UI/Sprites/AudioButton_Active.png');
    
    --statistics-button-default: url('project://database/Assets/UI/Png/button_start_normal.png');
    --statistics-button-hover: url('project://database/Assets/UI/Sprites/StatisticsButton_Hover.png');
    --statistics-button-active: url('project://database/Assets/UI/Sprites/StatisticsButton_Active.png');
    
    --info-button-default: url('project://database/Assets/UI/Png/button_start_normal.png');
    --info-button-hover: url('project://database/Assets/UI/Sprites/InfoButton_Hover.png');
    --info-button-active: url('project://database/Assets/UI/Sprites/InfoButton_Active.png');
    
    /* Иконки статистики */
    --timer-icon: url('project://database/Assets/UI/Sprites/TimerIcon.png');
    --skull-icon: url('project://database/Assets/UI/Sprites/SkullIcon.png');
    --flask-icon: url('project://database/Assets/UI/Sprites/FlaskIcon.png');
    
    /* Цвета */
    --text-color: rgb(255, 255, 255);
    --text-shadow: rgba(0, 0, 0, 0.8);
}

/* ==================== КОРНЕВОЙ КОНТЕЙНЕР ПАУЗЫ ==================== */

.pause-menu-root {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

.pause-menu-root.hidden {
    display: none;
}

.pause-background {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-image: var(--pause-background);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(0, 0, 0, 0.8); /* Затемнение если нет картинки */
}

.pause-content {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    flex-direction: column;
    padding: 30px;
}

/* ==================== ЗАГОЛОВОК ==================== */

.title-container {
    width: 400px;
    height: 100px;
    background-image: var(--title-container-bg);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.title-text {
    font-size: 48px;
    color: var(--text-color);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 4px var(--text-shadow);
}

/* ==================== ГЛАВНЫЙ КОНТЕЙНЕР ==================== */

.main-container {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
}

/* ==================== КОНТЕЙНЕР КНОПОК ==================== */

.options-buttons-container {
    width: 35%;
    min-width: 300px;
    background-image: var(--options-buttons-container-bg);
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: column;
    padding: 20px;
    margin-right: 20px;
}

/* ==================== КНОПКИ ВКЛАДОК ==================== */

.tab-button {
    width: 100%;
    height: 80px;
    margin-bottom: 15px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.2s;
    cursor: link;
}

.tab-button:active {
    scale: 0.98;
}

/* Resume Button */
.resume-tab-button {
    background-image: var(--resume-button-default);
}

.resume-tab-button:hover {
    background-image: var(--resume-button-hover);
    scale: 1.05;
}

.resume-tab-button.active {
    background-image: var(--resume-button-active);
}

/* Audio Button */
.audio-tab-button {
    background-image: var(--audio-button-default);
}

.audio-tab-button:hover {
    background-image: var(--audio-button-hover);
    scale: 1.05;
}

.audio-tab-button.active {
    background-image: var(--audio-button-active);
}

/* Statistics Button */
.statistics-tab-button {
    background-image: var(--statistics-button-default);
}

.statistics-tab-button:hover {
    background-image: var(--statistics-button-hover);
    scale: 1.05;
}

.statistics-tab-button.active {
    background-image: var(--statistics-button-active);
}

/* Info Button */
.info-tab-button {
    background-image: var(--info-button-default);
}

.info-tab-button:hover {
    background-image: var(--info-button-hover);
    scale: 1.05;
}

.info-tab-button.active {
    background-image: var(--info-button-active);
}

/* ==================== КОНТЕЙНЕР НАСТРОЕК ==================== */

.settings-container {
    width: 60%;
    flex-grow: 1;
    background-image: var(--settings-container-bg);
    -unity-background-scale-mode: stretch-to-fill;
    padding: 30px;
}

.settings-panel {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.settings-panel.hidden {
    display: none;
}

/* ==================== ПАНЕЛЬ RESUME ==================== */

.resume-panel {
    justify-content: center;
    align-items: center;
}

.big-action-button {
    width: 400px;
    height: 80px;
    font-size: 32px;
    -unity-font-style: bold;
    background-color: rgb(80, 120, 180);
    color: white;
    border-width: 3px;
    border-color: white;
    border-radius: 15px;
    margin-bottom: 30px;
    cursor: link;
    transition-duration: 0.2s;
}

.big-action-button:hover {
    background-color: rgb(100, 150, 220);
    scale: 1.05;
}

.big-action-button:active {
    background-color: rgb(60, 100, 150);
    scale: 0.98;
}

/* ==================== АУДИО НАСТРОЙКИ ==================== */

.audio-settings {
    flex-direction: column;
}

.audio-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
    width: 100%;
}

.audio-label {
    font-size: 24px;
    color: var(--text-color);
    width: 200px;
    -unity-text-align: middle-left;
    margin-right: 20px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px var(--text-shadow);
}

.volume-button {
    width: 50px;
    height: 50px;
    font-size: 28px;
    -unity-font-style: bold;
    background-color: rgb(80, 80, 80);
    color: white;
    border-width: 2px;
    border-color: white;
    border-radius: 8px;
    margin-left: 10px;
    margin-right: 10px;
    cursor: link;
}

.volume-button:hover {
    background-color: rgb(120, 120, 120);
    scale: 1.1;
}

.volume-button:active {
    background-color: rgb(60, 60, 60);
    scale: 0.95;
}

.volume-slider {
    flex-grow: 1;
    min-width: 200px;
}

.volume-slider .unity-base-slider__tracker {
    background-color: rgb(60, 60, 60);
    border-radius: 10px;
    height: 10px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
}

.volume-slider .unity-base-slider__dragger {
    width: 20px;
    height: 20px;
    background-color: white;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    top: -5px;
}

.volume-slider .unity-base-slider__dragger:hover {
    background-color: rgb(200, 200, 255);
    scale: 1.2;
}

.volume-slider .unity-base-slider__dragger:active {
    background-color: rgb(150, 150, 255);
}

/* ==================== СТАТИСТИКА ==================== */

.statistics-settings {
    flex-direction: column;
}

.stats-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
}

.stat-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 20px;
}

.timer-icon {
    background-image: var(--timer-icon);
}

.skull-icon {
    background-image: var(--skull-icon);
}

.flask-icon {
    background-image: var(--flask-icon);
}

.stat-text {
    font-size: 32px;
    color: var(--text-color);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px var(--text-shadow);
}

/* ==================== ИНФОРМАЦИЯ О КОМАНДЕ ==================== */

.info-settings {
    flex-direction: row;
}

.info-column {
    flex-direction: column;
    width: 50%;
    padding-right: 20px;
}

.info-header {
    font-size: 28px;
    color: var(--text-color);
    -unity-font-style: bold;
    margin-bottom: 15px;
    text-shadow: 2px 2px 4px var(--text-shadow);
}

.info-item {
    font-size: 20px;
    color: var(--text-color);
    margin-bottom: 10px;
    text-shadow: 1px 1px 3px var(--text-shadow);
}